# Copy to .env and change every secret before deployment
SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///learnwithhb.db
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeThisAdminPassword123!
SITE_URL=http://127.0.0.1:5000

# Razorpay (optional until you configure Test Mode credentials)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional private S3 storage. Keep bucket private and block public access.
S3_BUCKET=
AWS_REGION=ap-south-1
# Prefer EC2 instance role in production; don't put AWS keys here.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=25
